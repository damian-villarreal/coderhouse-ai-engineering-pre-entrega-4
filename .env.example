# Claves de API
PINECONE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Índice serverless de Pinecone
INDEX_NAME=rag-tecnico
PINECONE_NAMESPACE=tecnico
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# gemini | openai. La dimensión tiene que coincidir con el índice.
# gemini-embedding-001 admite 768, 1536 o 3072.
# text-embedding-3-small exige 1536.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536

# Cantidad de documentos que devuelve el recuperador híbrido
TOP_K=5
